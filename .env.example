# Copy to .env (never commit .env). On Railway, add these as service Variables.

# --- Dashboard access (HTTP Basic auth). Share these as the demo login. ---
DASHBOARD_USER=demo
DASHBOARD_PASSWORD=change-me

# --- Storage ---
DATABASE_PATH=data/app.db            # on Railway with a volume mounted at /data: /data/app.db

# --- LLM (Groq, OpenAI-compatible API) ---
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_PRICE_IN_PER_M=0.59             # USD per 1M input tokens — check Groq's pricing page
LLM_PRICE_OUT_PER_M=0.79            # USD per 1M output tokens

# --- Meta (shared) ---
META_VERIFY_TOKEN=any-random-string-you-choose
META_API_VERSION=v21.0

# --- WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
META_APP_SECRET=                     # Meta app secret → verifies X-Hub-Signature-256 on WhatsApp webhooks

# --- Instagram API with Instagram Login ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=                       # Instagram app secret → verifies Instagram webhook signatures

# --- Email (IMAP in / SMTP out; Gmail with an App Password works) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_POLL_SECONDS=30
EMAIL_ALLOWED_SENDERS=               # comma-separated test senders; empty = reply to anyone

# --- Google Calendar (OAuth web client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-APP.up.railway.app/oauth/google/callback
GOOGLE_CALENDAR_ID=primary
